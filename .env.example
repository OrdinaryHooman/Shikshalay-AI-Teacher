# Shikshalay AI Educator Environment Variables
# Copy this file to `.env` and replace placeholders with your real values.
# Never commit `.env` or real API keys.

# MySQL Database Configuration (For MySQL Workbench)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
MYSQL_DB=shikshalay

# Google Gemini API Key
GOOGLE_API_KEY=YOUR_API_KEY_HERE
GEMINI_API_KEY=YOUR_API_KEY_HERE

# GroqCloud LPU API Key (Optional, for ultra-low latency reasoning)
GROQ_API_KEY=YOUR_API_KEY_HERE
GROQ_MODEL=openai/gpt-oss-120b

# Optional provider overrides: 'gemini' or 'groq'
# LLM_PROVIDER_MISCONCEPTION=groq
# LLM_PROVIDER_QUESTION=groq
# LLM_PROVIDER_CHAT=groq
# LLM_PROVIDER_DOUBT=groq
